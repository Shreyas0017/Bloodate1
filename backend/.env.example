PORT=5000
# Server
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Postgres / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/bloodate

# Auth
JWT_SECRET=change_me

# Cloudinary (optional)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Gemini / AI parsing (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upload limits and cleanup
MAX_UPLOAD_BYTES=5242880
# If true, the server will delete the local copy after a successful cloud upload
CLEAN_LOCAL_AFTER_UPLOAD=false
# Number of days to keep local upload copies before cleanup (script: scripts/clean_uploads.js)
LOCAL_UPLOAD_RETENTION_DAYS=7
